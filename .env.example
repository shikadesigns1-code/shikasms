# Set these in Netlify > Site configuration > Environment variables (never commit real values)
APP_PASSWORD=choose-a-strong-password
SESSION_SECRET=long-random-string-32+chars
WEBHOOK_SECRET=another-random-string
SMS_PROVIDER=mock          # mock | arkesel
SMS_API_KEY=
DEFAULT_SENDER=MyLoans     # max 11 chars, must be approved by provider
